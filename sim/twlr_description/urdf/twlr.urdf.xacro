<?xml version="1.0"?>
<!--
  TWLR description - generated from CATIA assembly assembly_urdfchange_.stp
  Frame convention (ROS REP-103): x = forward, y = left, z = up.  CATIA -> ROS: x=-yc, y=+xc, z=+zc
  base_link origin = midpoint between the two hip motor axes.
  All joint angles = 0 at the CATIA assembly pose.
  Masses: slicer weights for printed parts, vendor weights for bought parts (see README.md).

  Arguments
    acrylic_mass  [kg]  acrylic cover mass. default 0.515 (CAD 433 cm3 x 1.19 g/cm3). Use 0.001 to simulate without the cover
    legs_fixed    true: hip/knee/coupler welded (stage 1 balance test). false: legs move (stage 2)
-->
<robot name="twlr" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="acrylic_mass" default="0.515"/>
  <xacro:arg name="legs_fixed" default="true"/>
  <xacro:property name="acrylic_mass" value="$(arg acrylic_mass)"/>
  <xacro:property name="leg_joint_type" value="${'fixed' if '$(arg legs_fixed)' == 'true' else 'revolute'}"/>

  <!-- Hip motor DM4340P: rated 9 N m, peak 27 N m (check datasheet). Hip range is a placeholder. -->
  <xacro:property name="hip_effort" value="27.0"/>
  <xacro:property name="hip_velocity" value="10.0"/>
  <xacro:property name="hip_lower" value="-0.8"/>
  <xacro:property name="hip_upper" value="0.8"/>
  <!-- Hub motor WA172E: Kt 1 N m/A, rated 5 N m, stall 13 N m, no-load 210 rpm.
       effort = ODrive current_lim 10 A x Kt 1 = 10 N m -->
  <xacro:property name="wheel_effort" value="10.0"/>
  <xacro:property name="wheel_velocity" value="22.0"/>
  <xacro:property name="wheel_radius" value="0.086"/>
  <xacro:property name="wheel_width" value="0.052"/>

  <material name="body"><color rgba="0.75 0.75 0.78 1"/></material>
  <material name="leg"><color rgba="0.55 0.55 0.58 1"/></material>
  <material name="tire"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="acrylic"><color rgba="0.6 0.8 1.0 0.25"/></material>

  <link name="base_link">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/base_link.stl"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0.0215 0 0.013" rpy="0 0 0"/>
      <geometry><box size="0.317 0.314 0.144"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.01130 -0.00219 0.00154" rpy="0 0 0"/>
      <mass value="2.8070"/>
      <inertia ixx="2.706199e-02" ixy="4.574782e-04" ixz="1.513751e-03" iyy="1.055549e-02" iyz="1.027592e-04" izz="3.241448e-02"/>
    </inertial>
  </link>

  <!-- Acrylic cover: same position as CAD, mass set by acrylic_mass argument -->
  <link name="acrylic_link">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/acrylic_link.stl"/></geometry>
      <material name="acrylic"/>
    </visual>
    <inertial>
      <origin xyz="0.06461 0.00000 0.04985" rpy="0 0 0"/>
      <mass value="${acrylic_mass}"/>
      <inertia ixx="${acrylic_mass*1.616320e-02}" ixy="${acrylic_mass*0.000000e+00}" ixz="${acrylic_mass*3.738697e-03}" iyy="${acrylic_mass*1.308371e-02}" iyz="${acrylic_mass*0.000000e+00}" izz="${acrylic_mass*2.349483e-02}"/>
    </inertial>
  </link>
  <joint name="acrylic_joint" type="fixed">
    <parent link="base_link"/><child link="acrylic_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- IMU (BNO085) position from CAD. Mounting orientation assumed aligned with base_link: verify on the real robot -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.00010 -0.00010 0.05610" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LEFT LEG ===================== -->
  <link name="thigh_L">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/thigh_L.stl"/></geometry>
      <material name="leg"/>
    </visual>
    <inertial>
      <origin xyz="-0.09612 0.00385 -0.09060" rpy="0 0 0"/>
      <mass value="0.3380"/>
      <inertia ixx="1.744309e-03" ixy="-5.194156e-05" ixz="-1.634135e-03" iyy="3.620024e-03" iyz="-4.895639e-05" izz="1.937868e-03"/>
    </inertial>
  </link>
  <link name="coupler_L">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/coupler_L.stl"/></geometry>
      <material name="leg"/>
    </visual>
    <inertial>
      <origin xyz="-0.05642 0.01290 -0.08751" rpy="0 0 0"/>
      <mass value="0.1370"/>
      <inertia ixx="8.186871e-04" ixy="-2.492300e-05" ixz="-5.174192e-04" iyy="1.153485e-03" iyz="-3.865787e-05" izz="3.497061e-04"/>
    </inertial>
  </link>
  <link name="shin_L">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/shin_L.stl"/></geometry>
      <material name="leg"/>
    </visual>
    <inertial>
      <origin xyz="0.03933 0.01497 -0.04315" rpy="0 0 0"/>
      <mass value="0.4730"/>
      <inertia ixx="2.713007e-03" ixy="-2.002972e-05" ixz="2.569481e-03" iyy="5.449341e-03" iyz="2.437509e-05" izz="2.918773e-03"/>
    </inertial>
  </link>
  <link name="wheel_L">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/wheel_L.stl"/></geometry>
      <material name="tire"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.00000 0.00001 0.00000" rpy="0 0 0"/>
      <mass value="2.2000"/>
      <inertia ixx="4.315678e-03" ixy="-5.995426e-11" ixz="-3.177143e-11" iyy="7.828312e-03" iyz="2.605829e-11" izz="4.315678e-03"/>
    </inertial>
  </link>
  <joint name="hip_L_joint" type="${leg_joint_type}">
    <parent link="base_link"/><child link="thigh_L"/>
    <origin xyz="0.00000 0.16700 0.00000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${hip_lower}" upper="${hip_upper}" effort="${hip_effort}" velocity="${hip_velocity}"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <joint name="coupler_L_joint" type="${leg_joint_type}">
    <parent link="base_link"/><child link="coupler_L"/>
    <origin xyz="-0.11400 0.16660 0.04900" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="20"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <joint name="knee_L_joint" type="${leg_joint_type}">
    <parent link="thigh_L"/><child link="shin_L"/>
    <origin xyz="-0.17400 0.02050 -0.16400" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="20"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <!-- positive wheel velocity = robot moves forward (+x) for BOTH wheels -->
  <joint name="wheel_L_joint" type="continuous">
    <parent link="shin_L"/><child link="wheel_L"/>
    <origin xyz="0.17000 0.05660 -0.17200" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="${wheel_effort}" velocity="${wheel_velocity}"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <gazebo reference="wheel_L"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>

  <!-- ===================== RIGHT LEG ===================== -->
  <link name="thigh_R">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/thigh_R.stl"/></geometry>
      <material name="leg"/>
    </visual>
    <inertial>
      <origin xyz="-0.09612 -0.00385 -0.09060" rpy="0 0 0"/>
      <mass value="0.3380"/>
      <inertia ixx="1.744310e-03" ixy="5.194156e-05" ixz="-1.634135e-03" iyy="3.620024e-03" iyz="4.895641e-05" izz="1.937868e-03"/>
    </inertial>
  </link>
  <link name="coupler_R">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/coupler_R.stl"/></geometry>
      <material name="leg"/>
    </visual>
    <inertial>
      <origin xyz="-0.05642 -0.01290 -0.08751" rpy="0 0 0"/>
      <mass value="0.1370"/>
      <inertia ixx="8.186864e-04" ixy="2.492300e-05" ixz="-5.174190e-04" iyy="1.153484e-03" iyz="3.865784e-05" izz="3.497061e-04"/>
    </inertial>
  </link>
  <link name="shin_R">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/shin_R.stl"/></geometry>
      <material name="leg"/>
    </visual>
    <inertial>
      <origin xyz="0.03855 -0.01518 -0.04239" rpy="0 0 0"/>
      <mass value="0.4730"/>
      <inertia ixx="2.672336e-03" ixy="3.110491e-05" ixz="2.527677e-03" iyy="5.368978e-03" iyz="-3.520729e-05" izz="2.877642e-03"/>
    </inertial>
  </link>
  <link name="wheel_R">
    <visual>
      <geometry><mesh filename="file://$(find twlr_description)/meshes/wheel_R.stl"/></geometry>
      <material name="tire"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.00000 -0.00001 0.00000" rpy="0 0 0"/>
      <mass value="2.2000"/>
      <inertia ixx="4.315678e-03" ixy="6.616095e-11" ixz="-3.577065e-11" iyy="7.828312e-03" iyz="-2.679858e-11" izz="4.315678e-03"/>
    </inertial>
  </link>
  <joint name="hip_R_joint" type="${leg_joint_type}">
    <parent link="base_link"/><child link="thigh_R"/>
    <origin xyz="0.00000 -0.16700 0.00000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${hip_lower}" upper="${hip_upper}" effort="${hip_effort}" velocity="${hip_velocity}"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <joint name="coupler_R_joint" type="${leg_joint_type}">
    <parent link="base_link"/><child link="coupler_R"/>
    <origin xyz="-0.11400 -0.16660 0.04900" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="20"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <joint name="knee_R_joint" type="${leg_joint_type}">
    <parent link="thigh_R"/><child link="shin_R"/>
    <origin xyz="-0.17400 -0.02050 -0.16400" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="20"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <!-- positive wheel velocity = robot moves forward (+x) for BOTH wheels -->
  <joint name="wheel_R_joint" type="continuous">
    <parent link="shin_R"/><child link="wheel_R"/>
    <origin xyz="0.17000 -0.05660 -0.17200" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="${wheel_effort}" velocity="${wheel_velocity}"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <gazebo reference="wheel_R"><mu1>1.0</mu1><mu2>1.0</mu2><kp>1e6</kp><kd>100</kd></gazebo>

  <!-- 4-bar loop closure (coupler - shin). URDF cannot describe loops, so it is added as raw SDF.
       Only used when legs_fixed:=false. Stage 2 item: verify in Gazebo before relying on it. -->
  <xacro:unless value="$(arg legs_fixed)">
    <gazebo>
      <joint name="closure_L_joint" type="revolute">
        <parent>coupler_L</parent><child>shin_L</child>
        <pose>-0.05450 0.00580 0.03540 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit></axis>
      </joint>
      <joint name="closure_R_joint" type="revolute">
        <parent>coupler_R</parent><child>shin_R</child>
        <pose>-0.05450 -0.00580 0.03540 0 0 0</pose>
        <axis><xyz>0 1 0</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit></axis>
      </joint>
    </gazebo>
  </xacro:unless>

  <!-- ===================== Gazebo sensors and plugins ===================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>400</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <!-- orientation relative to the world (gravity), like the real BNO085 game rotation vector -->
      <imu><orientation_reference_frame><localization>ENU</localization></orientation_reference_frame></imu>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <!-- wheel torque input: gz topic /model/twlr/joint/wheel_X_joint/cmd_force [N m] -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>wheel_L_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>wheel_R_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
